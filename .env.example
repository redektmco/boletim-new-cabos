# Banco de dados (libSQL). Em desenvolvimento, um arquivo SQLite local é usado.
# Em produção, use um banco Turso (a integração Turso da Vercel cria TURSO_DATABASE_URL/TURSO_AUTH_TOKEN,
# que também são aceitos).
DATABASE_URL="file:./data/boletim.db"
DATABASE_AUTH_TOKEN=""

# Segredo usado para assinar a sessão do painel. Gere com: openssl rand -base64 32
SESSION_SECRET=""

# Primeiro administrador — criado pelo `npm run db:migrate` (roda no build) se ainda não houver usuários;
# nesse momento a edição de 18/09/2026 também é publicada.
ADMIN_NAME="Marco Moraes"
ADMIN_EMAIL="marco@newcabos.com.br"
ADMIN_PASSWORD=""

# Upload de imagens de capa (Vercel Blob). Sem ele, em desenvolvimento as imagens vão para public/uploads.
BLOB_READ_WRITE_TOKEN=""

# URL pública do site (links de compartilhamento e prévia do WhatsApp).
# Opcional na Vercel: sem ela, usa o domínio de produção do projeto.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# WhatsApp comercial exibido no site (somente dígitos, com DDI)
NEXT_PUBLIC_WHATSAPP="5515996099494"
